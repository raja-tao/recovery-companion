# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------
# development | test | production
APP_ENV=development

# Database (docker compose builds DATABASE_URL from these)
POSTGRES_USER=recovery
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=recovery

# Auth — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-value
ACCESS_TOKEN_MINUTES=60

# Field-level encryption key for sensitive free text (Fernet, urlsafe base64 32 bytes).
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# In development, if empty, a key is derived from JWT_SECRET. Required in production.
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# AI providers. Claude is the default. With no key configured the system falls
# back to the deterministic "extractive" provider (quotes approved content only),
# so the whole demo still works offline.
# claude | openai | ollama | extractive
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high
CLAUDE_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# Embeddings: hashing (offline, default) | openai | ollama
# Changing provider/dimension requires `make reindex`.
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384

# Retrieval
RAG_TOP_K=4
RAG_MIN_SCORE=0.18

# ---------------------------------------------------------------------------
# Notifications: mock providers log + store. Swap for SES/SNS/Twilio later.
NOTIFICATION_EMAIL_PROVIDER=mock
NOTIFICATION_SMS_PROVIDER=mock

# Background jobs (reminders, missed check-in detection, SLA monitoring)
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=300

# Rate limiting (per client IP, per minute)
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30

# Inbound integrations (EHR FHIR / HL7 v2, RPM devices). Seeded sources get the key
# "<INTEGRATION_DEMO_KEY>-<source slug>", e.g. dev-integration-key-rpm-devices.
# Must be changed in production; rotate per-source keys from Admin › Integrations.
INTEGRATION_DEMO_KEY=dev-integration-key

# Seed synthetic data on startup if DB is empty
SEED_ON_STARTUP=true

# Ports
WEB_PORT=8080
DB_PORT=5433

# Outbound to the EHR (alerts → FHIR Communication, surveys → QuestionnaireResponse).
# Empty = simulated delivery (built and logged, not sent).
OUTBOUND_FHIR_URL=
OUTBOUND_FHIR_TOKEN=
